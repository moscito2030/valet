{
  "name": "valet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "prepare:dds": "node scripts/prepare-dds.mjs",
    "predev": "npm run prepare:dds && npm run manual:build",
    "predev:local": "npm run prepare:dds && npm run manual:build",
    "prebuild": "node scripts/check-deployment-deps.mjs && npm run prepare:dds && npm run manual:build && npm run manual:check",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:security": "node scripts/security-smoke.mjs",
    "profile:events": "tsx scripts/profile-event-flow.ts",
    "manual:build": "node scripts/build-manual.mjs",
    "manual:check": "node scripts/check-manual.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@valet/deal-viewer": "file:vendor/valet-deal-viewer-1.3.5.tgz",
